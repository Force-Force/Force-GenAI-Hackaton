ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_URL=
ZETARIS_SQL_ENDPOINT=/sql-editor/sqls/run
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
MODEL_BASE_URL=
MODEL_API_KEY=
NEMOTRON_MODEL=

# Active model route: nvidia or nightshift.
MODEL_PROVIDER=nvidia
# Nightshift credentials are separate from NVIDIA credentials.
NIGHTSHIFT_BASE_URL=
NIGHTSHIFT_API_KEY=
NIGHTSHIFT_MODEL=
# NVIDIA API Catalog / NIM OpenAI-compatible route.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

DATABASE_URL=postgresql+asyncpg://datapipe:datapipe@localhost:5432/datapipe

API_HOST=0.0.0.0
API_PORT=8000

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_ALL=false

# --- Analyse Nemotron ---
# MODEL_BASE_URL, MODEL_API_KEY and NEMOTRON_MODEL are required for Explain Why.

CHAT_HISTORY_LIMIT=20
METERLESS_MEMORY_LOG=logs/meterless_memory.jsonl

