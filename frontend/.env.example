# DataPipe frontend environment configuration.
# Copy to `.env` (or `.env.local`) and adjust per environment.

# Base URL for the FastAPI backend, including the versioned prefix.
# Local dev: leave as the relative default so the Vite proxy forwards to
# VITE_API_PROXY_TARGET (avoids CORS). Production: set the absolute origin,
# e.g. https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# Optional explicit WebSocket base. When omitted it is derived from
# VITE_API_BASE_URL (absolute) or the current page origin (relative dev proxy).
# Example absolute value: ws://localhost:8000/api/v1
# VITE_API_WS_URL=

# Origin the local Vite dev proxy forwards `/api` and `/health` to.
VITE_API_PROXY_TARGET=http://localhost:8000

# Optional bearer token. The MVP backend has no auth, so leave unset.
# VITE_API_AUTH_TOKEN=

# --- Frontend AI Agent (LLM that turns backend messages into canvas edits) ---
# These are READ SERVER-SIDE by the Vite dev/preview server (no VITE_ prefix),
# so the key is never shipped in the browser bundle and provider calls avoid
# CORS. Set AI_API_KEY to enable the LLM agent; leave it empty to fall back to
# the built-in deterministic (heuristic) agent.
#
# AI_PROVIDER: gateway | openai | anthropic | google   (default: gateway)
# AI_MODEL:    provider-specific model id. For the Vercel AI Gateway use a
#              "provider/model" string, e.g. openai/gpt-4o-mini. For a direct
#              provider use that provider's model id, e.g. gpt-4o-mini.
# AI_API_KEY:  the API key for the selected provider (or your AI Gateway key).
#
# AI_PROVIDER=gateway
# AI_MODEL=openai/gpt-4o-mini
# AI_API_KEY=
