# Base URL the frontend uses for all API calls to the FastAPI backend.
# Leave as "/api" to use the Vite dev proxy (see VITE_API_PROXY_TARGET).
VITE_API_BASE_URL=/api

# Where the Vite dev server proxies "/api" requests during local development.
VITE_API_PROXY_TARGET=http://localhost:8000

# Optional static auth token attached as "Authorization: Bearer <token>".
# Leave empty to disable. Real auth flows can replace this later.
VITE_API_AUTH_TOKEN=
