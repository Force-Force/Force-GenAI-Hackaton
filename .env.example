# AuraBI configuration — copy to .env and set NVIDIA_API_KEY. That is the only required value.
# .env is gitignored: never commit a real key.

# --- NVIDIA Nemotron (REQUIRED) ----------------------------------------------------------
# Free key: https://build.nvidia.com -> any model -> "Get API Key" (starts with nvapi-)
NVIDIA_API_KEY=
MODEL_PROVIDER=nvidia
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Zetaris (optional) ------------------------------------------------------------------
# By default AuraBI starts the Zetaris platform unzipped in ./zetaris-platform and signs in
# with its admin account. Override only to use another location or another account.
# ZETARIS_PLATFORM_DIR=./zetaris-platform
# ZETARIS_USERNAME=admin@zetaris.com
# ZETARIS_PASSWORD=
ZETARIS_MODE=local
ZETARIS_SQL_ENDPOINT=/sql-editor/sqls/run
ZETARIS_BANK_DATABASE=AURABI_BANK

# --- Ports on this machine (optional) ----------------------------------------------------
# AURABI_WEB_PORT=8080
# AURABI_API_PORT=8000
# AURABI_DB_PORT=5433
