# AuraBI — configuration. Copy to .env and fill the two REQUIRED values.
# .env is gitignored: never commit real keys.

# ---------------------------------------------------------------------------
# NVIDIA Nemotron (REQUIRED) — free key at https://build.nvidia.com ("Get API Key")
# ---------------------------------------------------------------------------
MODEL_PROVIDER=nvidia
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# ---------------------------------------------------------------------------
# Zetaris (REQUIRED) — the running Zetaris platform (local install or cloud)
# ---------------------------------------------------------------------------
# local = the Zetaris platform from zetaris-platform.zip, running on this machine.
# AuraBI joins its Docker network, so the services are reached by name (api, ui).
ZETARIS_MODE=local
ZETARIS_NETWORK=zetaris_default
ZETARIS_API_URL=http://api:8888/api/v1.0
ZETARIS_CLOUD_URL=
ZETARIS_SQL_ENDPOINT=/sql-editor/sqls/run
# Login used to obtain (and refresh) the short-lived Zetaris token.
ZETARIS_AUTH_URL=http://ui:3000/api/auth/login
ZETARIS_USERNAME=admin@zetaris.com
# REQUIRED: the admin password of your Zetaris platform
# (local install: ZETARIS_ADMIN_PASSWORD in zetaris-platform/.env)
ZETARIS_PASSWORD=
# Optional static bearer token (Zetaris Cloud). Leave empty to use the login above.
ZETARIS_API_KEY=
ZETARIS_ORG_ID=1
# Name under which the AuraBI bank database is registered in Zetaris.
ZETARIS_BANK_DATABASE=AURABI_BANK

# ---------------------------------------------------------------------------
# PostgreSQL (local container — defaults are fine)
# ---------------------------------------------------------------------------
POSTGRES_USER=datapipe
POSTGRES_PASSWORD=datapipe
POSTGRES_DB=datapipe
# Host port for the database (5433 avoids clashing with a local PostgreSQL).
DB_PORT=5433
# Read-only role Zetaris uses to read the bank schema.
BANK_READER_USER=zetaris_reader
BANK_READER_PASSWORD=reader_change_me
# How the Zetaris engine reaches this database (network alias on ZETARIS_NETWORK).
BANK_DB_HOST_FOR_ZETARIS=aurabi-db

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
API_PORT=8000
WEB_PORT=8080
